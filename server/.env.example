# =============================================================================
# Backend API Server Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Set to 'production' when deploying to Railway/production
# This affects CORS, cookie security, and error handling
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port the server listens on (Railway sets this automatically)
PORT=8787

# -----------------------------------------------------------------------------
# CORS / Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend URLs
# Development: Include both Vite dev server and any local testing URLs
APP_ORIGIN=http://localhost:5173,http://localhost:8080

# Production example (update with your actual domains):
# APP_ORIGIN=https://sillymarket.fun,https://www.sillymarket.fun,https://sillymarket.vercel.app

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string from Supabase
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String (Direct)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Production: Use the connection string from Supabase (includes pooling)
# Example: postgres://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Session Secret (CRITICAL SECURITY)
# -----------------------------------------------------------------------------
# Used to sign JWT tokens for user sessions
# MUST be a strong random string (minimum 32 characters)
# 
# Generate a secure secret with:
#   openssl rand -base64 32
#   or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ⚠️ NEVER use the default value in production!
# ⚠️ Changing this will invalidate all existing user sessions
SESSION_SECRET=replace_with_long_random_string_min_32_chars

# Production: Generate and set a strong random secret
# Example: SESSION_SECRET=Kx7j9mP2nQ5vW8zA3bC6dE1fG4hJ0kL9mN2oP5qR8sT1uV4wX7yZ0

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to Railway:
# 
# 1. Set NODE_ENV=production
# 2. Generate and set a strong SESSION_SECRET (openssl rand -base64 32)
# 3. Update APP_ORIGIN with your production frontend URLs
# 4. Set DATABASE_URL to your Supabase connection string
# 5. Verify all environment variables are set in Railway dashboard
# 
# Railway will automatically set PORT, so you don't need to configure it.
# =============================================================================
