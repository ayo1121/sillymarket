# Silly Character Service Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API key for LLM calls
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Shared secret for authenticating requests from backend
# Generate with: openssl rand -base64 32
SOUL_ENGINE_TOKEN=

# Optional: Server port (Railway sets this automatically)
# PORT=4310
