# =============================================================================
# Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and update with your actual values
# NEVER commit .env.local to version control!
#
# ⚠️ SECURITY: Only VITE_* variables are exposed to the browser
# Never put secrets (API keys, private keys, etc.) in VITE_* variables!

# -----------------------------------------------------------------------------
# Backend API URL
# -----------------------------------------------------------------------------
# URL of your backend API server
# Development: Local server
VITE_API_URL=http://localhost:8787

# Production: Railway custom domain or Railway-provided URL
# Example: VITE_API_URL=https://api.sillymarket.fun
# or: VITE_API_URL=https://yesno-markets-production.up.railway.app

# -----------------------------------------------------------------------------
# Solana RPC Endpoint
# -----------------------------------------------------------------------------
# Solana RPC node for blockchain interactions
# Development: Local validator or devnet
VITE_RPC_URL=http://127.0.0.1:8899
# or devnet: VITE_RPC_URL=https://api.devnet.solana.com

# Production: Use a reliable mainnet RPC provider
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/YOUR_TOKEN/
# Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# Example: VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=abc123

# -----------------------------------------------------------------------------
# Anchor Program ID
# -----------------------------------------------------------------------------
# Your deployed Anchor program's public key
# Development: Devnet program ID
VITE_PROGRAM_ID=8gBJBtEkyN95vd9bXTRKxyAaoLiTkogFmecEfQCSNJgb

# Production: Mainnet program ID (deploy with `anchor deploy`)
# Example: VITE_PROGRAM_ID=YourMainnetProgramId111111111111111111111

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > API
# 
# ✅ SAFE: Publishable (anon) key is safe to expose in frontend
# ❌ NEVER use service_role key in frontend - it bypasses RLS!

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key - SAFE for frontend
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Solana Transaction Configuration
# -----------------------------------------------------------------------------
# Transaction commitment level (confirmed, finalized, processed)
VITE_COMMITMENT=confirmed

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Require wallet connection to use the app (1 = required, 0 = optional)
VITE_REQUIRE_WALLET=1

# Debug dock for development (0 = disabled, 1 = enabled)
# ⚠️ Set to 0 in production to hide debug UI
VITE_DEBUG_DOCK=0

# Solana priority fee in microlamports (0 = no priority)
# Higher values = faster transaction confirmation
VITE_PRIORITY_MICROLAMPORTS=0

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST (Vercel)
# =============================================================================
# Before deploying to Vercel:
# 
# 1. Set VITE_API_URL to your Railway backend URL
# 2. Set VITE_RPC_URL to a mainnet RPC endpoint (Helius/QuickNode/Alchemy)
# 3. Set VITE_PROGRAM_ID to your mainnet program ID
# 4. Set VITE_SUPABASE_URL to your Supabase project URL
# 5. Set VITE_SUPABASE_PUBLISHABLE_KEY to your Supabase anon key
# 6. Set VITE_DEBUG_DOCK=0 to disable debug UI
# 7. Verify VITE_COMMITMENT=confirmed for production
# 
# In Vercel Dashboard:
# - Go to Project Settings > Environment Variables
# - Add each VITE_* variable for Production environment
# - Redeploy after adding variables
# =============================================================================

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ✅ DO expose in frontend (VITE_* prefix):
#    - API URLs, RPC endpoints, program IDs
#    - Supabase URL and publishable key
#    - Public configuration flags
#
# ❌ NEVER expose in frontend:
#    - Supabase service_role key (backend only!)
#    - Private keys, mnemonics, secrets
#    - Database credentials
#    - SESSION_SECRET or any auth secrets
# =============================================================================
